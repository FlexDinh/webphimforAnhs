<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://rophim.tv.app" 
        version="1.0.0"
        viewmodes="maximized">
    
    <tizen:application id="rophimtv.rophimtv" package="rophimtv" required_version="2.3"/>
    <name>RoPhim TV</name>
    <description>Xem phim online miễn phí trên Smart TV - HD/4K, Vietsub, Thuyết minh</description>
    
    <icon src="icon.png"/>
    <content src="index.html"/>
    
    <!-- Quyền truy cập -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    
    <!-- Cho phép load URL bên ngoài -->
    <access origin="https://webphimfor-anhs.vercel.app" subdomains="true"/>
    <access origin="https://*.vercel.app" subdomains="true"/>
    <access origin="https://*.ophim.live" subdomains="true"/>
    <access origin="https://phimapi.com" subdomains="true"/>
    <access origin="https://ophim1.com" subdomains="true"/>
    <access origin="https://*.phimimg.com" subdomains="true"/>
    <access origin="https://phim.nguonc.com" subdomains="true"/>
    <access origin="https://image.tmdb.org" subdomains="true"/>
    <access origin="https://fonts.googleapis.com" subdomains="true"/>
    <access origin="https://fonts.gstatic.com" subdomains="true"/>
    <access origin="*" subdomains="true"/>
    
    <tizen:setting screen-orientation="landscape" 
                   context-menu="disable" 
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"/>
    
    <tizen:content-security-policy>
        default-src * 'self'; script-src * 'self' 'unsafe-inline' 'unsafe-eval'; style-src * 'self' 'unsafe-inline'; img-src * 'self' data: blob: https:; media-src * 'self' blob: https:; connect-src * 'self' https: wss:; font-src * 'self' data: https:; frame-src * 'self' https:;
    </tizen:content-security-policy>
</widget>
